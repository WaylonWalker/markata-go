  "incomplete_palette_families": [],
  "derived_palette_counterparts": {
    "description": "Each former singleton family has an explicit counterpart. The counterpart keeps the source family and ID identity, and appends the missing variant suffix to its canonical ID.",
    "strategy": "For every role color, convert sRGB to HSL, replace lightness L with 1-L, preserve hue and saturation, round each output channel to the nearest 8-bit value, and serialize as lowercase #rrggbb. This deterministic lightness reflection derives light from dark and dark from light without aliasing to another family.",
    "source_scope": "singleton_palette_families"
  },
